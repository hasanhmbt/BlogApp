<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
    <style>
        body {
            font-family: "Arial", sans-serif;
            background: linear-gradient(to bottom right, #eef2f3, #8e9eab);
            color: #333;
            margin: 0;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 0.5rem 1rem; /* Reduced padding for a smaller nav appearance */
        }

            .navbar .nav-link {
                color: #007bff !important;
                margin-right: 15px;
            }

                .navbar .nav-link:hover, .navbar .nav-link.active {
                    color: #0056b3 !important;
                }

        main.container {
            padding-top: 20px; /* Reduced top padding to bring content closer to navbar */
        }

        /* Footer Styles */
        .footer {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
            padding: 20px 0;
            margin-top: 40px; /* Gives some space after main content */
        }

            .footer a {
                color: #007bff;
                margin: 0 10px;
                text-decoration: none;
            }

                .footer a:hover {
                    color: #0056b3;
                }

        .footer-icons i {
            font-size: 1.5rem;
            margin: 0 10px;
            color: #007bff;
            transition: color 0.3s ease;
        }

            .footer-icons i:hover {
                color: #0056b3;
            }

        /* Glass box styling can be placed in the individual pages */
        /* If needed in a specific page:
                   .glass-box {
                       background: rgba(255, 255, 255, 0.6);
                       backdrop-filter: blur(10px);
                       border-radius: 10px;
                       box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
                       padding: 20px;
                       margin-bottom: 20px;
                   }
                */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary" href="/">MyApp</a>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("Home", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteArticles", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteArticles">Articles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteSubjects", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteSubjects">Subjects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteFiles", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteFiles">Files</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - MyApp. All rights reserved.</p>
            <div class="footer-icons">
                <a href="https://www.linkedin.com/in/your-profile" target="_blank" title="LinkedIn">
                    <i class="fab fa-linkedin"></i>
                </a>
                <a href="https://github.com/your-profile" target="_blank" title="GitHub">
                    <i class="fab fa-github"></i>
                </a>
                <a href="https://twitter.com/your-profile" target="_blank" title="Twitter">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://facebook.com/your-profile" target="_blank" title="Facebook">
                    <i class="fab fa-facebook"></i>
                </a>
                <a href="https://instagram.com/your-profile" target="_blank" title="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
