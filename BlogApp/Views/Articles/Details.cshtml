@model Article

@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Article Details";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h1 class="m-0 font-weight-bold text-primary">@Model.Title</h1>
        </div>
        <div class="card-body">
            <p><strong>Publication Date:</strong> @Model.PublicationDate.ToString("MMMM dd, yyyy")</p>
            <div>
                @Html.Raw(Model.Description)
            </div>
            @if (!string.IsNullOrEmpty(Model.FilePath))
            {
                <div class="mt-3">
                    <img src="@Model.FilePath" alt="@Model.Title" class="img-fluid" />
                </div>
            }
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
