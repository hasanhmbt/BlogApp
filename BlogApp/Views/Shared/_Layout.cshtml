<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
    <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTnk--SvPlYeNa-ifACcbFidmvFab12ul9mLQ&s">
    <style>
        body {
            font-family: "Arial", sans-serif;
            background: linear-gradient(to bottom right, #eef2f3, #8e9eab);
            color: #333;
            margin: 0;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 0.5rem 1rem;
        }

        .navbar-nav {
            margin: 0 auto;
        }

        .navbar .nav-link {
            color: #007bff !important;
            margin: 0 10px;
        }

            .navbar .nav-link:hover, .navbar .nav-link.active {
                color: #0056b3 !important;
            }

        main.container {
            padding-top: 20px;
        }

        .footer {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
            padding: 20px 0;
            margin-top: 40px;
        }

            .footer a {
                color: #007bff;
                margin: 0 10px;
                text-decoration: none;
            }

                .footer a:hover {
                    color: #0056b3;
                }

        .footer-icons i {
            font-size: 1.5rem;
            margin: 0 10px;
            color: #007bff;
            transition: color 0.3s ease;
        }

            .footer-icons i:hover {
                color: #0056b3;
            }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container-fluid">
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("Home", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteArticles", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteArticles">Articles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteSubjects", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteSubjects">Subjects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString().Equals("SiteFiles", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")" href="/SiteFiles">Files</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - All rights reserved. Created by<a href="https://www.linkedin.com/in/hasanhmbt/">Hasan Humbatov</a></p>
            <div class="footer-icons">
                <a href="https://www.linkedin.com/in/qadir-qafarov-a55340108/" target="_blank" title="LinkedIn">
                    <i class="fab fa-linkedin"></i>
                </a>
                <a href="https://www.facebook.com/profile.php?id=100005683185790" target="_blank" title="Facebook">
                    <i class="fab fa-facebook"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
