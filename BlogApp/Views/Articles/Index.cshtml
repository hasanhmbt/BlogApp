@model IEnumerable<Article>
 
@{
    Layout = "_DashboardLayout";
    ViewBag.Title = "Articles";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Articles</h6>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </div>

        <div class="card-body">
            <div class="form-inline mb-3">
                <input type="text" id="searchInput" placeholder="Search by title" class="form-control mr-2">
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="articlesTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Publication Date</th>
                            <th>Excerpt</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model)
                        {
                            <tr>
                                <td>@article.Title</td>
                                <td>@article.PublicationDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @Html.Raw(article.Description != null && article.Description.Length > 50
                                        ? article.Description.Substring(0, 50) + "..."
                                        : article.Description ?? "No Description")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-controller="Articles" asp-route-id="@article.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-controller="Articles" asp-route-id="@article.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@article.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this article?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <nav>
                    <ul class="pagination">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage - 1)">Previous</a>
                            </li>
                        }
                        @for (var i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(currentPage + 1)">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section js {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            var searchValue = this.value.toLowerCase();
            var table = document.getElementById('articlesTable');
            var rows = table.getElementsByTagName('tr');

            for (var i = 1; i < rows.length; i++) {
                var titleCell = rows[i].getElementsByTagName('td')[0];
                if (titleCell) {
                    var titleText = titleCell.textContent || titleCell.innerText;
                    if (titleText.toLowerCase().indexOf(searchValue) > -1) {
                        rows[i].style.display = '';
                    } else {
                        rows[i].style.display = 'none';
                    }
                }
            }
        });
    </script>
}
